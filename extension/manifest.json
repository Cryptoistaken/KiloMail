{
  "manifest_version": 3,
  "name": "KiloMail",
  "version": "1.0.0",
  "description": "Your KiloMail disposable inbox in the browser side panel — free, real-time, no sign-up, no API key.",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open KiloMail sidebar"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel"],
  "host_permissions": ["https://kilomail.tech/*"]
}
