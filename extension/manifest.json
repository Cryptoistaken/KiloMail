{
  "manifest_version": 3,
  "name": "KiloMail",
  "version": "1.1.0",
  "description": "Your KiloMail disposable inbox in the browser side panel — free, real-time, no sign-up, no API key.",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open KiloMail sidebar",
    "default_icon": {
      "16": "icons/on-light/16.png",
      "32": "icons/on-light/32.png"
    }
  },
  "icons": {
    "16": "icons/on-light/16.png",
    "32": "icons/on-light/32.png",
    "48": "icons/on-light/48.png",
    "128": "icons/on-light/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel"],
  "host_permissions": ["https://kilomail.tech/*"]
}
